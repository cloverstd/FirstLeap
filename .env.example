# Server-local Compose configuration. Never put SMB credentials here.
FIRSTLEAP_IMAGE=ghcr.io/cloverstd/firstleap@sha256:REPLACE_WITH_PUBLISHED_DIGEST
FIRSTLEAP_HOST=firstleap.example.internal
FIRSTLEAP_MEDIA_PATH=/srv/firstleap/media
FIRSTLEAP_READING_PATH=/srv/firstleap/readings
# Optional ebook overlay: COMPOSE_FILE=compose.yaml:compose.textbooks.yaml
# FIRSTLEAP_TEXTBOOK_PATH=/srv/firstleap/textbooks
